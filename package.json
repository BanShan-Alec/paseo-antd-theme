{
  "name": "paseo-antd-themes",
  "version": "0.1.0",
  "description": "Paseo Dark and Claude Light themes for Ant Design v6.",
  "type": "module",
  "license": "MIT",
  "author": "BanShan-Alec",
  "homepage": "https://github.com/BanShan-Alec/paseo-antd-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BanShan-Alec/paseo-antd-theme.git"
  },
  "bugs": {
    "url": "https://github.com/BanShan-Alec/paseo-antd-theme/issues"
  },
  "keywords": [
    "antd",
    "ant-design",
    "theme",
    "dark",
    "light",
    "paseo",
    "claude",
    "react"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "import": "./dist/claude.js",
      "require": "./dist/claude.cjs"
    },
    "./paseo": {
      "types": "./dist/paseo.d.ts",
      "import": "./dist/paseo.js",
      "require": "./dist/paseo.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "MAPPING.md",
    "LICENSE",
    "docs"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:demo": "tsc --noEmit && vite build --outDir dist-demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build:lib",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "antd": ">=6.6.0 <7",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@ant-design/colors": "^8.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "antd": "^6.6.6",
    "jsdom": "^26.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^3.2.0"
  }
}
