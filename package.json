{
  "name": "paseo-antd-theme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter paseo-antd-themes build && pnpm --filter @paseo/demo dev",
    "build": "pnpm -r build",
    "build:lib": "pnpm --filter paseo-antd-themes build",
    "build:demo": "pnpm --filter paseo-antd-themes build && pnpm --filter @paseo/demo build",
    "typecheck": "pnpm --filter paseo-antd-themes build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "gen:tailwind": "pnpm --filter paseo-antd-themes gen:tailwind",
    "gen:mapping": "pnpm --filter paseo-antd-themes gen:mapping",
    "verify:package": "pnpm --filter paseo-antd-themes verify:package",
    "verify:demo": "node scripts/verify-demo-consumption.mjs"
  }
}
